{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default Build",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
          "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
          "GLFW_BUILD_X11": "OFF",
          "GLFW_BUILD_WAYLAND": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    }
  ]
}
